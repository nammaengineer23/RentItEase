<file path="backend/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  fullName            String
  email               String               @unique
  phone               String               @unique
  role                UserRole             @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordHash        String
  isActive            Boolean              @default(true)
  ownerConversations  Conversation[]       @relation("OwnerConversations")
  tenantConversations Conversation[]       @relation("TenantConversations")
  favorites           Favorite[]
  sentMessages        Message[]            @relation("MessageSender")
  notifications       Notification[]
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
  properties          Property[]
  visits              PropertyVisit[]      @relation("TenantVisits")
  refreshTokens       RefreshToken[]
  reviews             Review[]
  devices             UserDevice[]
}

model UserDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id              String            @id @default(cuid())
  title           String
  description     String
  price           Decimal           @db.Decimal(10, 2)
  address         String
  city            String
  state           String
  country         String
  pincode         String
  bedrooms        Int
  bathrooms       Int
  area            Float
  propertyType    PropertyType
  furnishing      FurnishingType
  parking         Boolean           @default(false)
  petFriendly     Boolean           @default(false)
  securityDeposit Decimal           @db.Decimal(10, 2)
  isAvailable     Boolean           @default(true)
  ownerId         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  landmark        String?
  latitude        Decimal?          @db.Decimal(9, 6)
  locality        String?
  longitude       Decimal?          @db.Decimal(9, 6)
  displayOrder    Int               @default(0)
  conversations   Conversation[]
  favorites       Favorite[]
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  amenities       PropertyAmenity[]
  images          PropertyImage[]
  visits          PropertyVisit[]
  reviews         Review[]
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  createdAt  DateTime          @default(now())
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model PropertyImage {
  id           String   @id @default(cuid())
  imageUrl     String
  publicId     String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  propertyId   String
  createdAt    DateTime @default(now())
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

model PropertyVisit {
  id         String      @id @default(cuid())
  propertyId String
  tenantId   String
  visitDate  DateTime
  status     VisitStatus @default(PENDING)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     User        @relation("TenantVisits", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([visitDate])
}

model Notification {

  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String

  message String

  type NotificationType @default(GENERAL)

  isRead Boolean @default(false)

  relatedId String?

  createdAt DateTime @default(now())

  @@index([userId])

  @@index([relatedId])
}

model Conversation {
  id         String    @id @default(cuid())
  propertyId String
  ownerId    String
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  owner      User      @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     User      @relation("TenantConversations", fields: [tenantId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([propertyId, ownerId, tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  messageType    MessageType  @default(TEXT)
  deletedAt      DateTime?
  editedAt       DateTime?
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  email     String
  otpHash   String
  purpose   OtpPurpose
  expiresAt DateTime
  isUsed    Boolean    @default(false)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  STUDIO
  ROOM
  PG
}

enum FurnishingType {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
