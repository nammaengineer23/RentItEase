<file path="backend/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  fullName                String
  email                   String                   @unique
  phone                   String                   @unique
  role                    UserRole                 @default(USER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  passwordHash            String
  isActive                Boolean                  @default(true)
  photoUrl                String?
  bookings                Booking[]                @relation("TenantBookings")
  ownerConversations      Conversation[]           @relation("OwnerConversations")
  tenantConversations     Conversation[]           @relation("TenantConversations")
  favorites               Favorite[]
  invoices                Invoice[]
  leases                  Lease[]                  @relation("TenantLeases")
  memberships             Membership[]
  sentMessages            Message[]                @relation("MessageSender")
  notifications           Notification[]
  otpCodes                OtpCode[]
  passwordResetTokens     PasswordResetToken[]
  premiumListings         PremiumListing[]
  properties              Property[]
  visits                  PropertyVisit[]          @relation("TenantVisits")
  refreshTokens           RefreshToken[]
  reviews                 Review[]
  socialMarketingConsents SocialMarketingConsent[]
  devices                 UserDevice[]
  settings                UserSettings?
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  pushNotifications  Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  darkMode           Boolean  @default(false)
  language           String   @default("en")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id                     String                  @id @default(cuid())
  title                  String
  description            String
  price                  Decimal                 @db.Decimal(10, 2)
  address                String
  city                   String
  state                  String
  country                String
  pincode                String
  bedrooms               Int
  bathrooms              Int
  area                   Float
  propertyType           PropertyType
  furnishing             FurnishingType
  parking                Boolean                 @default(false)
  petFriendly            Boolean                 @default(false)
  securityDeposit        Decimal                 @db.Decimal(10, 2)
  isAvailable            Boolean                 @default(true)
  ownerId                String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  landmark               String?
  latitude               Decimal?                @db.Decimal(9, 6)
  locality               String?
  longitude              Decimal?                @db.Decimal(9, 6)
  displayOrder           Int                     @default(0)
  bookings               Booking[]
  conversations          Conversation[]
  favorites              Favorite[]
  leases                 Lease[]
  premiumListings        PremiumListing[]
  owner                  User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  amenities              PropertyAmenity[]
  images                 PropertyImage[]
  visits                 PropertyVisit[]
  reviews                Review[]
  socialMarketingConsent SocialMarketingConsent?
  socialMediaPosts       SocialMediaPost[]
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  createdAt  DateTime          @default(now())
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model PropertyImage {
  id           String               @id @default(cuid())
  imageUrl     String
  publicId     String?
  isPrimary    Boolean              @default(false)
  displayOrder Int                  @default(0)
  propertyId   String
  createdAt    DateTime             @default(now())
  section      PropertyImageSection @default(OTHER)
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model SocialMarketingConsent {
  id             String            @id @default(cuid())
  propertyId     String            @unique
  ownerId        String
  approved       Boolean           @default(false)
  autoPublish    Boolean           @default(false)
  platforms      Json
  consentVersion String            @default("1.0")
  consentedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property       Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  posts          SocialMediaPost[]

  @@index([ownerId])
  @@index([approved])
  @@index([autoPublish])
}

model SocialMediaPost {
  id          String                  @id @default(cuid())
  propertyId  String
  consentId   String?
  platform    SocialPlatform
  status      SocialPostStatus        @default(PENDING)
  caption     String?
  videoUrl    String?
  externalId  String?
  error       String?
  publishedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  consent     SocialMarketingConsent? @relation(fields: [consentId], references: [id])
  property    Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([platform])
  @@index([status])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

model PropertyVisit {
  id         String      @id @default(cuid())
  propertyId String
  tenantId   String
  visitDate  DateTime
  status     VisitStatus @default(PENDING)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  booking    Booking?
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     User        @relation("TenantVisits", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([visitDate])
}

model Booking {
  id              String        @id @default(cuid())
  propertyId      String
  tenantId        String
  visitId         String        @unique
  status          BookingStatus @default(PENDING)
  monthlyRent     Decimal       @db.Decimal(10, 2)
  securityDeposit Decimal       @db.Decimal(10, 2)
  bookingDate     DateTime      @default(now())
  approvedAt      DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant          User          @relation("TenantBookings", fields: [tenantId], references: [id], onDelete: Cascade)
  visit           PropertyVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  lease           Lease?
  payment         Payment?

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([bookingDate])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  userId        String
  paymentId     String?
  amount        Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  currency      String        @default("INR")
  status        InvoiceStatus @default(GENERATED)
  description   String?
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  pdfUrl        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentId])
  @@index([status])
  @@index([invoiceDate])
}

model MembershipPlan {
  id              String             @id @default(cuid())
  name            String
  code            MembershipPlanCode @unique
  description     String?
  price           Decimal            @db.Decimal(10, 2)
  durationDays    Int
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  memberships     Membership[]
  premiumListings PremiumListing[]

  @@index([code])
  @@index([isActive])
}

model Membership {
  id              String           @id @default(cuid())
  userId          String
  planId          String
  status          MembershipStatus @default(PENDING)
  startDate       DateTime?
  endDate         DateTime?
  activatedAt     DateTime?
  expiredAt       DateTime?
  cancelledAt     DateTime?
  autoRenew       Boolean          @default(false)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  plan            MembershipPlan   @relation(fields: [planId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  premiumListings PremiumListing[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model PremiumListing {
  id               String               @id @default(cuid())
  propertyId       String
  userId           String
  membershipId     String?
  status           PremiumListingStatus @default(PENDING)
  startDate        DateTime?
  endDate          DateTime?
  activatedAt      DateTime?
  expiredAt        DateTime?
  cancelledAt      DateTime?
  durationDays     Int
  amount           Decimal              @db.Decimal(10, 2)
  currency         String               @default("INR")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  membershipPlanId String?
  membership       Membership?          @relation(fields: [membershipId], references: [id])
  membershipPlan   MembershipPlan?      @relation(fields: [membershipPlanId], references: [id])
  property         Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@index([membershipId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model Lease {
  id              String      @id @default(cuid())
  bookingId       String      @unique
  propertyId      String
  tenantId        String
  status          LeaseStatus @default(ACTIVE)
  monthlyRent     Decimal     @db.Decimal(10, 2)
  securityDeposit Decimal     @db.Decimal(10, 2)
  startDate       DateTime
  endDate         DateTime?
  signedAt        DateTime?
  terminatedAt    DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  booking         Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  property        Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant          User        @relation("TenantLeases", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  paidAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  type      NotificationType @default(GENERAL)
  relatedId String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([relatedId])
}

model Conversation {
  id         String    @id @default(cuid())
  propertyId String
  ownerId    String
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  owner      User      @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     User      @relation("TenantConversations", fields: [tenantId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([propertyId, ownerId, tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  messageType    MessageType  @default(TEXT)
  deletedAt      DateTime?
  editedAt       DateTime?
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  email     String
  otpHash   String
  purpose   OtpPurpose
  expiresAt DateTime
  isUsed    Boolean    @default(false)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model SocialCampaign {
  id          String               @id @default(cuid())
  propertyId  Int
  status      SocialCampaignStatus @default(DRAFT)
  template    String?
  caption     String?
  hashtags    String[]
  videoUrl    String?
  deepLink    String?
  qrCodeUrl   String?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([propertyId])
  @@index([status])
}

model SocialAccountConnection {
  id                    String    @id @default(cuid())
  platform              String
  accountId             String
  accountName           String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  expiresAt             DateTime?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([platform, accountId])
  @@index([platform])
}

model SocialAnalyticsSnapshot {
  id          String   @id @default(cuid())
  campaignId  String
  platform    String
  impressions Int      @default(0)
  clicks      Int      @default(0)
  likes       Int      @default(0)
  shares      Int      @default(0)
  leads       Int      @default(0)
  capturedAt  DateTime @default(now())

  @@index([campaignId])
  @@index([platform, capturedAt])
}

