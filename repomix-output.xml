  return (
    <section>
      <div className="section-heading">
        <div>
          <h2>Platform Analytics</h2>
          <p className="muted">
            Monitor RentItEase users, properties and engagement.
          </p>
        </div>

        <button
          className="secondary-button"
          onClick={() => void loadAnalytics()}
