      .expect(200);

    const data = extractData(res.body);

    const memberships = Array.isArray(data)
      ? data
      : (data?.memberships ?? res.body?.memberships ?? []);

    expect(Array.isArray(memberships)).toBe(true);

    const membership = memberships.find(
