    super.initState();

    Future.microtask(() {
      ref.read(searchProvider.notifier).loadRecentSearches();
    });
  }

  @override
  void dispose() {
    searchController.dispose();
    super.dispose();
  }

  Future<void> _search() async {
    await ref
        .read(searchProvider.notifier)
        .search(SearchEntity(query: searchController.text.trim()));
  }

  @override
