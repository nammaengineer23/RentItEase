      rent:
          (property['rent'] ?? 0)
              .toDouble(),



      deposit:
          (property['deposit'] ?? 0)
              .toDouble(),



      location:
          property['location'] ?? '',



      address:
          property['address'] ?? '',



      imageUrl:
          property['imageUrl'],

    );

  }






  Map<String,dynamic> toJson(){


    return {


      'id':
          id,


      'propertyId':
          propertyId,


      'title':
          title,


      'description':
          description,


      'propertyType':
          propertyType,


      'bhk':
