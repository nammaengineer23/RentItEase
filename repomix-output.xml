      id,
      propertyId,
      propertyTitle,
      propertyImage,
      senderId,
      receiverId,
      senderName,
      receiverName,
      senderAvatar,
      receiverAvatar,
      lastMessage,
      lastMessageTime,
      unreadCount,
      isOnline,
      isTyping,
      isRead,
