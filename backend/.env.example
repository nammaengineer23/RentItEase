# RentItEase backend environment template
# Never commit real values. Production secrets belong in the deployment secret manager.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rentitease

JWT_ACCESS_SECRET=replace-with-32-plus-random-bytes
JWT_REFRESH_SECRET=replace-with-32-plus-random-bytes
PASSWORD_RESET_URL=https://rentitease.com/reset-password

FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase Storage is the sole authoritative application storage provider.
STORAGE_DRIVER=firebase

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@rentitease.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

OPENAI_API_KEY=
OPENAI_LISTING_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

CORS_ORIGINS=https://rentitease.com,https://www.rentitease.com
# Production API host allowlist; comma-separated exact hostnames.
ALLOWED_HOSTS=api.rentitease.com
# Set to the number of trusted reverse proxies in production when known.
TRUST_PROXY=1

SWAGGER_ENABLED=false
SWAGGER_DOCS_TOKEN=

SOCIAL_AUTOMATION_MODE=GENERATE_ONLY
SOCIAL_SCHEDULER_ENABLED=false
SOCIAL_ACCOUNT_ENCRYPTION_KEY=
META_GRAPH_VERSION=v23.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=
YOUTUBE_DEFAULT_PRIVACY=private

# Razorpay webhook signing secret configured in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# Durable admin audit retention (minimum enforced: 30 days)
ADMIN_AUDIT_RETENTION_DAYS=365
